{
  "schemaVersion": 1,
  "id": "shinigami.workspaces",
  "name": "Shinigami Workspaces",
  "version": "0.2.5",
  "author": "guiestrela",
  "license": "MIT",
  "description": "Shared Hyprland workspace state with the Shinigami workspace presentation.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "WorkspaceService.qml"
  },
  "barWidget": {
    "displayName": "Shinigami workspaces",
    "description": "Workspace state, switching, styles, and detail panel",
    "category": "Desktop",
    "defaultSection": "left",
    "allowMultiple": false
  },
  "x-shinigami": {
    "suiteId": "hancore.shinigami",
    "bundle": "default",
    "role": "G2",
    "capabilities": ["workspaces"],
    "preferredRegion": "left",
    "requires": [
      "shinigami.state"
    ],
    "recommends": []
  }
}
