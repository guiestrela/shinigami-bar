{
  "schemaVersion": 1,
  "id": "shinigami.control-center",
  "name": "Shinigami Control Center",
  "version": "0.2.5",
  "author": "guiestrela",
  "license": "MIT",
  "description": "Shinigami G1 presentation and bar configuration panel.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "PluginUpdateService.qml"
  },
  "barWidget": {
    "displayName": "Shinigami settings",
    "description": "Configure Shinigami layout, widgets, and appearance",
    "category": "System",
    "defaultSection": "left",
    "allowMultiple": false
  },
  "x-shinigami": {
    "suiteId": "hancore.shinigami",
    "bundle": "core",
    "role": "G1",
    "requires": [
      "shinigami.state"
    ],
    "recommends": []
  }
}
