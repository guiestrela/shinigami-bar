{
  "schemaVersion": 1,
  "id": "shinigami.audio",
  "name": "Shinigami Audio",
  "version": "0.2.5",
  "author": "guiestrela",
  "license": "MIT",
  "description": "Shinigami audio presentation over Omarchy's PipeWire owner.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Shinigami audio",
    "description": "Volume, mute, microphone, devices, and application streams",
    "category": "Audio",
    "defaultSection": "left",
    "allowMultiple": false
  },
  "x-shinigami": {
    "suiteId": "hancore.shinigami",
    "bundle": "default",
    "role": "G6",
    "capabilities": [
      "audio"
    ],
    "preferredRegion": "left",
    "requires": [
      "shinigami.state"
    ],
    "recommends": []
  }
}
