{
  "schemaVersion": 1,
  "id": "shinigami.update-center",
  "name": "Shinigami Update Center",
  "version": "0.2.5",
  "author": "guiestrela",
  "license": "MIT",
  "description": "Safe repository package and user theme update status for Shinigami.",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Shinigami update center",
    "description": "Review repository package and user theme updates",
    "category": "System",
    "defaultSection": "right",
    "allowMultiple": false
  },
  "x-shinigami": {
    "suiteId": "hancore.shibumi",
    "bundle": "default",
    "role": "update-center",
    "requires": [
      "shinigami.state"
    ],
    "recommends": []
  }
}
