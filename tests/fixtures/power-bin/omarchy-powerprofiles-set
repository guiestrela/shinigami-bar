#!/usr/bin/env bash

set -euo pipefail

[[ ${1:-} == autodetect && $# -eq 2 ]] || exit 2
case $2 in
  power-saver|balanced|performance) ;;
  *) exit 3 ;;
esac
printf '%s\n' "$2" >"${SHINIGAMI_POWER_FIXTURE_STATE:?}.tmp"
mv -f -- "${SHINIGAMI_POWER_FIXTURE_STATE}.tmp" "$SHINIGAMI_POWER_FIXTURE_STATE"
