{
  "schemaVersion": 1,
  "id": "shinigami.temperature",
  "name": "Shinigami Temperature",
  "version": "0.2.5",
  "author": "guiestrela",
  "license": "MIT",
  "description": "Demand-driven hardware temperature widget and sensor panel.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Shinigami Temperature",
    "description": "Hardware temperature and sensor inventory",
    "category": "System",
    "defaultSection": "right",
    "allowMultiple": false
  },
  "x-shinigami": {
    "suiteId": "hancore.shinigami",
    "bundle": "default",
    "role": "G16",
    "requires": [
      "shinigami.state",
      "shinigami.telemetry"
    ],
    "recommends": []
  }
}
